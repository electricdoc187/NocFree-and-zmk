#undef ZMK_BEHAVIORS_KEEP_ALL

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    /*
     * Fn + Esc:
     *   tap       = restart the left half normally
     *   hold 1.5s = enter the left-half UF2 bootloader
     *
     * Hold-tap always receives two parameters. Both child behaviors take no
     * parameters, so the key binding passes two dummy zero values.
     */

    behaviors {
        bootloader_hold: bootloader_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "BOOTLOADER_HOLD";
            bindings = <&bootloader>, <&sys_reset>;

            #binding-cells = <2>;
            tapping-term-ms = <1500>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * Windows Japanese (JIS) oriented base layer.
         * INT_YEN/INT_RO are JIS punctuation keys.
         * INT_HENKAN/INT_MUHENKAN are Henkan/Muhenkan.
         * LGUI is the Windows key and LALT/RALT are Alt keys on Windows.
         */

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp F1          &kp F2     &kp F3              &kp F4     &kp F5      &kp F6
&kp F7     &kp F8          &kp F9     &kp F10             &kp F11    &kp F12     &kp PSCRN    &kp HOME
&kp GRAVE  &kp N1          &kp N2     &kp N3              &kp N4     &kp N5      &kp N6
&kp N7     &kp N8          &kp N9     &kp N0              &kp MINUS  &kp EQUAL   &kp INT_YEN  &kp BSPC
&kp TAB    &kp Q           &kp W      &kp E               &kp R      &kp T
&kp Y      &kp U           &kp I      &kp O               &kp P      &kp LBKT    &kp RBKT     &kp DEL
&kp CAPS   &kp A           &kp S      &kp D               &kp F      &kp G
&kp H      &kp J           &kp K      &kp L               &kp SEMI   &kp SQT     &kp BSLH     &kp RET
&kp LSHFT  &kp Z           &kp X      &kp C               &kp V      &kp B
&kp N      &kp M           &kp COMMA  &kp DOT             &kp FSLH   &kp INT_RO  &kp RSHFT    &kp UP
&kp LCTRL  &kp LGUI        &kp LALT   &lt 1 INT_MUHENKAN  &kp SPACE
&kp SPACE  &kp INT_HENKAN  &kp RALT   &mo 1               &kp RCTRL  &kp LEFT    &kp DOWN     &kp RIGHT
            >;
        };

        /*
         * Fn layer:
         *   Fn+Esc     = tap restart / hold 1.5s left bootloader
         *   Fn+F10/F11/F12 = mute / volume down / volume up
         *   Fn+1..5    = select Bluetooth profiles 0..4
         *   Fn+0       = clear the selected Bluetooth pairing
         *   Fn+U       = prefer USB output
         *   Fn+Delete  = enter the right-half bootloader
         *
         * &trans inherits the binding from the Base layer.
         */

        function_layer {
            display-name = "Fn";
            bindings = <
&bootloader_hold 0 0  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans        &trans        &trans        &trans
&kp C_PREV            &kp C_PP              &kp C_NEXT            &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  &trans          &trans
&trans                &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &studio_unlock
&trans                &trans                &trans                &bt BT_CLR    &trans        &trans        &trans          &trans
&trans                &trans                &trans                &trans        &trans        &trans
&trans                &out OUT_USB          &trans                &trans        &trans        &trans        &trans          &bootloader_hold 0 0
&trans                &trans                &trans                &trans        &trans        &trans
&trans                &trans                &trans                &trans        &trans        &trans        &trans          &trans
&trans                &trans                &trans                &trans        &trans        &trans
&trans                &trans                &trans                &trans        &trans        &trans        &trans          &trans
&trans                &trans                &trans                &trans        &trans
&trans                &trans                &trans                &trans        &trans        &trans        &trans          &trans
            >;
        };

        layer_2 {
            status = "reserved";
        };
    };
};
